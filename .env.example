# 复制为 .env 即可被服务端自动加载；已存在的环境变量优先，不会被覆盖
# 服务端唯一的密钥来源，前端不接触（PRD 4.1）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容端点，可替换为其他模型服务商
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 服务监听端口
PORT=8787
# 单日用量：超过告警阈值写告警日志，超过硬上限直接拒绝（PRD 4.1）
DAILY_CALL_ALERT=500
DAILY_CALL_CAP=1500
