{
  "name": "zhipin-assistant",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:docs": "node --test tests/prd.sync.test.js tests/prd.nfr.test.js tests/tech-design.test.js tests/demo.smoke.test.js",
    "test:all": "pnpm test && pnpm test:docs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "pnpm --filter @zhipin/web build",
    "dev:api": "pnpm --filter @zhipin/api dev",
    "dev:web": "pnpm --filter @zhipin/web dev",
    "mock:model": "pnpm --filter @zhipin/api mock:model",
    "test:e2e": "pnpm --filter @zhipin/web build && playwright test",
    "quality:samples": "tsx scripts/quality-regression.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
